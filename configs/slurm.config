params {
  container_chipfilter = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/singularity_image/samtools-bedtools-py3.sif"

  cpus   = 2
  memory = '8 GB'
  time   = '8h'

  queue        = 'cpu_p'
  extra_mounts = ''
  mail_user    = 'molendo.hpc@gmail.com'
}

process {
  executor = 'slurm'
  queue          = params.queue
  clusterOptions = "--qos=cpu_normal --nice=10000 --mail-type=END,FAIL --mail-user=${params.mail_user}"

  cpus   = params.cpus
  memory = params.memory
  time   = params.time

  container = params.container_chipfilter
  containerOptions = params.extra_mounts


  withName: filter_multimappers {
    cpus   = 2
    memory = '8 GB'
    time   = '4h'
  }

  withName: mito_stats {
    cpus   = 2
    memory = '8 GB'
    time   = '4h'
  }
}

singularity {
  enabled    = true
  autoMounts = true
}
